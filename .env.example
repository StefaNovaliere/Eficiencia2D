# ============================================================================
# IMPORTANTE — local vs Vercel:
#   En LOCAL, `npm run dev` lee estas variables desde un archivo `.env.local`
#   en la raíz (NO se commitea). Las variables cargadas en el dashboard de
#   Vercel SOLO existen en los deploys de Vercel: NO llegan a localhost.
#   -> Copiá este archivo a `.env.local` y completá los valores reales, o usá
#      `vercel env pull .env.local`. Reiniciá el dev server después de crearlo.
# ============================================================================

# Frontend (Next.js) — opcional. URL del backend separado, si se usa.
# NEXT_PUBLIC_API_URL=https://your-backend-service.up.railway.app

# ─── Mercado Pago ───
# Get credentials at: https://www.mercadopago.com.ar/developers/panel/app
# Server-side only (NEVER expose to client)
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-00000000000000000000000000000000-000000000
MP_BYPASS_KEY=your-secret-bypass-key

# Client-side (public — safe to expose)
NEXT_PUBLIC_MP_PUBLIC_KEY=TEST-00000000-0000-0000-0000-000000000000
